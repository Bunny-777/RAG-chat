# ==============================================================================
# AI Research Analyst Configuration
# ==============================================================================

# Required: Groq API Key for LLaMA 3.3 70B inference
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Hugging Face Token (if using gated models)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACEHUB_API_TOKEN=

# Model Settings
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# RAG Ingestion Defaults
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=4

# Optional: YouTube Proxy Settings (if encountering YouTube IP blocking)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
PROXY_HTTP_URL=
PROXY_HTTPS_URL=